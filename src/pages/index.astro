---
import Layout from '../layouts/Layout.astro';
import { base } from '../i18n';
---
<Layout>
  <main class="container entry">
    <p>Gabriel Ferrari</p>
    <h1>Software Engineer<br/>iOS</h1>
    <nav aria-label="Idioma / Language"><a class="button primary" href={`${base}pt/`} data-language="pt" lang="pt-BR" hreflang="pt-BR">Português</a><a class="button" href={`${base}en/`} data-language="en" lang="en" hreflang="en">English</a></nav>
  </main>
</Layout>
<style>
  .entry{padding-block:96px}.entry p{font-size:24px}h1{font-family:var(--display);font-size:clamp(40px,7vw,96px);line-height:1.05;letter-spacing:-.045em;margin-block:48px}nav{display:flex;flex-wrap:wrap;gap:16px}
</style>
