---
import { copy, type Locale } from '../i18n';
interface Props { locale: Locale }
const c = copy[Astro.props.locale];
---
<section class="section container" id="technical" aria-labelledby="technical-heading">
  <div class="section-heading"><h2 id="technical-heading">{c.technical}</h2><p>{c.technicalLead}</p></div>
  <div class="grid profile">
    <article class="ios motion-enter" data-motion="capability"><h3>{c.ios}</h3><p class="technologies">Swift, SwiftUI</p><div class="caption"><strong>{c.iosEvidence}</strong><span><a href="#carely">Carely</a>, <a href="#fintech">Fintech</a>, <a href="#jordania">Jordania</a></span></div></article>
    <article class="backend motion-enter" data-motion="capability" style="--delay:100ms"><h3>{c.backend}</h3><p class="technologies">TypeScript, NestJS, Java, Spring Boot, REST APIs, PostgreSQL</p><div class="caption"><strong>{c.backendEvidence}</strong><span><a href="#fintech">Fintech</a>, <a href="#jordania">Jordania</a></span></div></article>
    <article class="web motion-enter" data-motion="capability" style="--delay:180ms"><h3>{c.web}</h3><p class="technologies">Astro, TypeScript, HTML, CSS</p><div class="caption"><strong>{c.webEvidence}</strong><span><a href="#hero">{c.portfolio}</a></span></div></article>
  </div>
</section>
<style>

.profile{align-items:start;position:relative}.ios{grid-column:1/7;padding:24px 48px 40px 0;position:relative}
.ios:before{content:'';position:absolute;inset:-24px 24px 0 calc((100vw - 200%)/-2);z-index:-1;background:linear-gradient(130deg,var(--wash),transparent);clip-path:polygon(0 0,100% 0,100% 80%,90% 80%,90% 100%,0 100%)}
.backend{grid-column:7/10;padding:24px 0}.web{grid-column:10/-1;padding:24px 0}article{min-width:0}
h3{font-size:24px;line-height:1.2}.ios h3{font-family:var(--display);font-size:clamp(48px,4.5vw,64px);letter-spacing:-.045em;max-width:10ch}
.technologies{margin-top:24px;color:var(--secondary)}.ios .technologies{font-size:32px;color:var(--text)}
.caption{margin-top:32px}.caption strong{font-weight:400}.caption a{display:inline-flex;align-items:center;min-height:44px}
@media(min-width:600px) and (max-width:1023px){.ios{grid-column:1/5;padding:24px 24px 32px 0}.backend,.web{grid-column:5/-1;padding:0}.backend{grid-row:1}.web{grid-row:2}.ios{grid-row:1/3}.ios h3{font-size:44px}.ios:before{left:-32px}}
@media(max-width:599px){.profile{gap:40px}.ios,.backend,.web{grid-column:1/-1}.ios{padding:24px 16px 32px 0}.ios:before{inset:-16px calc(var(--gutter)*-1) 0 calc(var(--gutter)*-1)}.backend,.web{padding:0}.ios h3{font-size:48px}.technologies{margin-top:16px}.caption{margin-top:24px}}

</style>
