---
import type { CollectionEntry } from 'astro:content';
import { copy, type Locale } from '../i18n';
import Screen from './Screen.astro';
import ProjectLinks from './ProjectLinks.astro';
interface Props { project: CollectionEntry<'projects'>; locale: Locale }
const { project, locale } = Astro.props;
const p = project.data[locale];
const c = copy[locale];
---
<article class="carely" id="carely" aria-labelledby="carely-heading">
  <div class="screens">
    <div class="intro"><div class="identity motion-enter" data-motion="title">
      <p class="project-kind">{p.kind}</p><h3 class="project-title" id="carely-heading">Carely</h3><p class="project-summary">{p.summary}</p>
    </div></div>
    <Screen image={project.data.images.filter(i => !i.secondary)[0]!} locale={locale} index={0} />
    <div class="scope">
      <dl><div><dt>{c.contribution}</dt><dd>{p.contribution}</dd></div><div><dt>{c.technology}</dt><dd>{project.data.technologies.join(', ')}</dd></div></dl>
      <ProjectLinks project={project} locale={locale} />
    </div>
    {project.data.images.filter(i => !i.secondary).slice(1).map((image,index) => <Screen image={image} locale={locale} index={index+1} />)}
  </div>
  <details>
    <summary>{c.institutions}</summary>
    <div class="institutions">{project.data.images.filter(i => i.secondary).map((image,index) => <Screen image={image} locale={locale} index={index+3} />)}</div>
  </details>
  <p class="note">{p.note}</p>
</article>
<dialog id="image-dialog" aria-labelledby="image-title">
  <div class="dialog-heading"><h2 id="image-title"></h2><form method="dialog"><button class="button" autofocus>{c.close}</button></form></div>
  <img id="image-expanded" alt="" width="738" height="1600" />
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#image-dialog');
  const image = document.querySelector<HTMLImageElement>('#image-expanded');
  const title = document.querySelector<HTMLElement>('#image-title');
  if (dialog && image && title && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('[data-enlarge]').forEach(link => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.addEventListener('click', event => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        image.src = link.href;
        image.alt = link.querySelector('img')?.alt ?? '';
        title.textContent = link.dataset.title ?? '';
        link.focus({ preventScroll: true });
        dialog.showModal();
        dialog.scrollTop = 0;
      });
    });
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
  }
</script>
<style>

.carely{position:relative;isolation:isolate;padding-block:48px 64px;display:grid;grid-template-columns:3fr 4.6fr 3.4fr;gap:24px 48px;align-items:start}
.carely:before{content:'';position:absolute;inset:104px calc((100vw - 100%)/-2) 80px;z-index:-2;background:linear-gradient(145deg,var(--carely-surface),var(--carely-wash));clip-path:polygon(0 0,74% 0,74% 8%,100% 8%,100% 100%,0 100%);pointer-events:none}
.carely:after{content:'';position:absolute;left:27%;right:-24px;top:32px;height:260px;border-top:1px solid color-mix(in srgb,var(--interaction) 32%,transparent);border-right:1px solid color-mix(in srgb,var(--interaction) 32%,transparent);border-radius:0 48px 0 0;z-index:-1;pointer-events:none}
.intro{display:block;grid-column:1;grid-row:1}.identity,.scope{min-width:0}.scope{grid-column:1;grid-row:2;margin-top:16px}
.project-title{font-size:clamp(80px,7.5vw,112px);letter-spacing:-.06em}.project-summary{max-width:26ch;font-size:25px}
dl{display:grid;grid-template-columns:minmax(0,1fr);gap:16px}dt{font-weight:600;margin-bottom:8px;font-size:16px}dd{font-size:17px;line-height:1.5;color:var(--secondary)}
dl>div:last-child{display:flex;align-items:baseline;gap:16px}dl>div:last-child dt{margin:0}
.screens{display:contents}
.screens :global(.screen-0){grid-column:2;grid-row:1/4;margin-top:0}
.screens :global(.screen-1){grid-column:3;grid-row:1/4;margin-top:176px}
.screens :global(.screen-2){grid-column:1;grid-row:3;margin-top:16px}
details{grid-column:2/-1;grid-row:4;max-width:760px;margin-top:0}
summary{font-size:18px;min-height:48px;padding-block:12px;color:var(--interaction)}
.institutions{display:grid;grid-template-columns:repeat(2,minmax(0,240px));gap:48px;margin-block:32px}
.note{grid-column:2/-1;grid-row:5;margin-top:0}
dialog{background:var(--surface);color:var(--text);width:min(850px,calc(100% - 32px));max-height:90dvh;border:1px solid var(--divider);border-radius:12px;padding:16px;overscroll-behavior:contain;box-shadow:var(--shadow)}
@keyframes amplify{from{opacity:0;transform:translateY(8px) scale(.975)}to{opacity:1;transform:none}}dialog[open]{animation:amplify 280ms var(--ease)}
dialog::backdrop{background:#000b;backdrop-filter:blur(4px)}
.dialog-heading{position:sticky;top:0;z-index:1;display:flex;gap:16px;align-items:center;justify-content:space-between;padding-bottom:16px;background:var(--surface)}
.dialog-heading h2{font-size:20px}.dialog-heading button{background:var(--surface);color:var(--text);padding:12px}
#image-expanded{width:100%;height:auto;border-radius:8px}
@media(min-width:600px) and (max-width:1023px){.carely{display:block}.intro{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:24px}.identity{grid-column:1/-1}.scope{margin:0 0 32px}.project-title{font-size:88px}.project-summary{font-size:24px}.screens{display:grid;grid-template-columns:1.16fr .86fr 1fr;gap:24px}.intro{grid-column:1/3;grid-row:1}.scope{grid-column:3;grid-row:1}.screens :global(.screen-0){grid-column:1;grid-row:2}.screens :global(.screen-1){grid-column:2;grid-row:2}.screens :global(.screen-2){grid-column:3;grid-row:2}.screens :global(.screen-1){margin-top:96px}.screens :global(.screen-2){margin-top:176px}details{margin-top:32px}.note{margin-top:16px}.carely:after{top:40px;left:32%;right:-16px}.carely:before{inset-block-start:96px}}
@media(max-width:599px){.carely{padding-block:24px 48px;display:grid;grid-template-columns:minmax(0,1fr);gap:40px}.carely:before{inset:96px -24px 96px;clip-path:polygon(0 0,85% 0,85% 5%,100% 5%,100% 100%,0 100%)}.carely:after{left:50%;right:-8px;top:40px;height:100px;border-radius:0 32px 0 0}.intro{display:contents}.identity{grid-column:1;grid-row:1}.scope{grid-column:1;grid-row:3;margin:0;padding:24px 0;border-top:1px solid color-mix(in srgb,var(--interaction) 20%,transparent)}.project-title{font-size:88px}.project-summary{font-size:24px;max-width:24ch}dl{gap:24px}.screens :global(.screen-0){grid-column:1;grid-row:2}.screens :global(.screen-1){grid-column:1;grid-row:4;margin-top:0}.screens :global(.screen-2){grid-column:1;grid-row:5;margin-top:0}.institutions{display:flex;flex-direction:column;gap:32px}details{grid-column:1;grid-row:6;margin-top:0}.note{grid-column:1;grid-row:7;margin-top:-24px}.dialog-heading{align-items:start}.dialog-heading button{font-size:16px}}
@media(max-width:359px){.carely:before{inset-inline:-16px}.project-title{font-size:80px}}

</style>
