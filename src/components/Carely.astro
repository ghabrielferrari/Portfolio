---
import type { CollectionEntry } from 'astro:content';
import { copy, type Locale } from '../i18n';
import Screen from './Screen.astro';
import ProjectLinks from './ProjectLinks.astro';
interface Props { project: CollectionEntry<'projects'>; locale: Locale }
const { project, locale } = Astro.props;
const p = project.data[locale];
const c = copy[locale];
---
<article class="carely" id="carely" aria-labelledby="carely-heading">
  <div class="intro grid">
    <div class="identity">
    <p class="project-kind">{p.kind}</p>
    <h3 class="project-title" id="carely-heading">Carely</h3>
    <p class="project-summary">{p.summary}</p>
    </div>
    <div class="scope">
    <dl>
      <div><dt>{c.contribution}</dt><dd>{p.contribution}</dd></div>
      <div><dt>{c.technology}</dt><dd>{project.data.technologies.join(', ')}</dd></div>
    </dl>
    <ProjectLinks project={project} locale={locale} />
    </div>
  </div>
  <div class="evidence">
    <div class="screens">
      {project.data.images.filter(i => !i.secondary).map((image,index) => <Screen image={image} locale={locale} index={index} />)}
    </div>
    <details>
      <summary>{c.institutions}</summary>
      <div class="institutions">
        {project.data.images.filter(i => i.secondary).map((image,index) => <Screen image={image} locale={locale} index={index+3} />)}
      </div>
    </details>
    <p class="note">{p.note}</p>
  </div>
</article>
<dialog id="image-dialog" aria-labelledby="image-title">
  <div class="dialog-heading"><h2 id="image-title"></h2><form method="dialog"><button class="button" autofocus>{c.close}</button></form></div>
  <img id="image-expanded" alt="" width="738" height="1600" />
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#image-dialog');
  const image = document.querySelector<HTMLImageElement>('#image-expanded');
  const title = document.querySelector<HTMLElement>('#image-title');
  if (dialog && image && title && typeof dialog.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('[data-enlarge]').forEach(link => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.addEventListener('click', event => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        image.src = link.href;
        image.alt = link.querySelector('img')?.alt ?? '';
        title.textContent = link.dataset.title ?? '';
        link.focus({ preventScroll: true });
        dialog.showModal();
        dialog.scrollTop = 0;
      });
    });
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
  }
</script>
<style>

  .carely{position:relative;isolation:isolate;padding:48px;border-radius:12px;background:var(--carely-surface)}
  .carely:before{content:'';position:absolute;inset:0;z-index:-1;border-radius:inherit;background:radial-gradient(ellipse at 80% 40%,var(--carely-wash),transparent 65%);pointer-events:none}
  .identity{grid-column:1/6}.scope{grid-column:7/-1;align-self:center}
  .project-title{font-size:clamp(64px,6.4vw,88px)}
  .project-summary{max-width:28ch}
  dl{display:grid;grid-template-columns:minmax(0,1fr) 120px;gap:32px}
  dt{font-weight:600;margin-bottom:8px;font-size:16px}
  dd{font-size:18px;line-height:1.5;color:var(--secondary)}
  .evidence{margin-top:64px;min-width:0}
  .screens{display:grid;grid-template-columns:1.08fr .93fr 1fr;gap:clamp(32px,4.5vw,64px);align-items:start;max-width:1032px;margin-inline:auto}
  details{margin-top:48px;background:color-mix(in srgb,var(--surface) 65%,transparent);border-radius:8px;padding:8px 16px}
  summary{font-size:16px;min-height:44px;padding-block:10px;color:var(--interaction)}
  .institutions{display:grid;grid-template-columns:repeat(2,minmax(0,240px));gap:48px;justify-content:center;margin-block:24px}
  .note{margin-top:16px}
  dialog{background:var(--surface);color:var(--text);width:min(850px,calc(100% - 32px));max-height:90dvh;border:1px solid var(--divider);border-radius:12px;padding:16px;overscroll-behavior:contain;box-shadow:var(--shadow)}
  dialog::backdrop{background:#000b;backdrop-filter:blur(4px)}
  .dialog-heading{position:sticky;top:0;z-index:1;display:flex;gap:16px;align-items:center;justify-content:space-between;padding-bottom:16px;background:var(--surface)}
  .dialog-heading h2{font-size:20px}
  .dialog-heading button{background:var(--surface);color:var(--text);padding:12px}
  #image-expanded{width:100%;height:auto;border-radius:8px}
  @media(min-width:600px) and (max-width:1023px){.carely{padding:32px}.identity{grid-column:1/5}.scope{grid-column:5/-1}dl{grid-template-columns:1fr;gap:16px}.evidence{margin-top:48px}.screens{gap:32px}}
  @media(max-width:599px){.carely{padding:32px 16px;margin-inline:-8px}.intro{gap:32px}.identity,.scope{grid-column:1/-1}dl{grid-template-columns:1fr;gap:24px}.project-title{font-size:64px}.evidence{margin-top:48px}.screens{display:flex;flex-direction:column;gap:48px}.institutions{display:flex;flex-direction:column;gap:32px}details{margin-top:32px;padding-inline:12px}.dialog-heading{align-items:start}.dialog-heading button{font-size:16px}}

</style>
