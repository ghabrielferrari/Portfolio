---
import { copy, base, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
---
<a class="skip-link" href="#main">{c.skip}</a>
<header class="container">
  <a class="brand" href={`${base}${locale}/`}>Gabriel Ferrari</a>
  <nav class="main-nav" aria-label={c.navigation}>
    <a href="#work">{c.work}</a><a href="#technical">{c.technical}</a><a href="#about">{c.about}</a><a href="#contact">{c.contact}</a>
  </nav>
  <nav class="languages" aria-label={c.language}>
    {(['pt','en'] as const).map(l => <a href={`${base}${l}/`} data-language={l} lang={l === 'pt' ? 'pt-BR' : 'en'} hreflang={l === 'pt' ? 'pt-BR' : 'en'} aria-current={locale === l ? 'page' : undefined}>{l.toUpperCase()}</a>)}
  </nav>
</header>
<style>
  header{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-block:24px;border-bottom:0}
  a{display:inline-flex;align-items:center;min-height:44px;text-decoration:none;font-size:16px}
  a:hover{text-decoration:underline}
  .brand{color:var(--text);font-weight:600;font-size:20px;white-space:nowrap}
  .main-nav{display:flex;flex-wrap:wrap;gap:24px}
  .languages{display:flex;gap:4px}
  .languages a{justify-content:center;width:44px;border-radius:8px}
  .languages [aria-current]{background:var(--surface);color:var(--text);border:1px solid var(--divider)}
  @media(max-width:767px){header{display:grid;grid-template-columns:1fr auto;gap:4px 16px;padding-block:12px}.main-nav{grid-row:2;grid-column:1/-1;justify-content:space-between;gap:8px}.languages{grid-column:2;grid-row:1}.main-nav a{font-size:16px}}
  @media(max-width:359px){.main-nav{gap:4px}.main-nav a{font-size:15px}.brand{font-size:18px}}
</style>
