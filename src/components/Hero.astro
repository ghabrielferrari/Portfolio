---
import { Image } from 'astro:assets';
import portrait from '../assets/gabriel-ferrari.png';
import { copy, base, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
---
<section class="hero container grid" id="hero" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="hero-enter"><span class="role">Software Engineer</span>{' '}<span class="focus">{c.headline.replace('Software Engineer ', '')}</span></h1>
  <svg class="hero-axis hero-enter" style="--delay:60ms" viewBox="0 0 1000 600" fill="none" aria-hidden="true"><path d="M36 26H650Q710 26 710 86V444Q710 500 766 500H956"/><circle cx="36" cy="26" r="5"/><circle cx="956" cy="500" r="5"/></svg>
  <div class="support-layout">
  <figure class="portrait hero-enter" style="--delay:120ms">
    <Image src={portrait} widths={[160,240,320,460,640]} sizes="(max-width:599px) 132px, (max-width:1023px) 230px, 340px" alt="Gabriel Ferrari" loading="eager" fetchpriority="high" format="webp" />
  </figure>
  <p class="support hero-enter" style="--delay:180ms">{c.support}</p>
  </div>
  <div class="actions hero-enter" style="--delay:240ms">
    <a class="button primary" href="#work">{c.projectsCTA}</a>
    <a class="button" href={locale === 'pt' ? `${base}assets/documents/gabriel-ferrari-cv-pt.pdf` : '#contact'} download={locale === 'pt' ? 'Gabriel-Ferrari-CV-PT.pdf' : undefined}>{c.secondCTA}</a>
  </div>
</section>
<style>

.hero{position:relative;isolation:isolate;padding-block:64px 80px;row-gap:24px;align-items:start}
.hero:before{content:'';position:absolute;z-index:-2;inset:100px calc((100vw - 100%)/-2) 64px 34%;background:linear-gradient(135deg,var(--wash),color-mix(in srgb,var(--wash) 32%,var(--bg)));clip-path:polygon(0 0,100% 0,100% 100%,18% 100%,18% 70%,0 70%);pointer-events:none}
h1{grid-column:1/10;grid-row:1;position:relative;z-index:2;font-family:var(--display);font-size:clamp(88px,9.2vw,132px);line-height:.97;letter-spacing:-.06em;max-width:15ch}
.role{display:block;max-width:12ch}.focus{display:block;font-size:.62em;line-height:1.12;margin-top:16px;letter-spacing:-.045em}
.support-layout{display:contents}
.portrait{grid-column:9/-1;grid-row:1/4;align-self:start;justify-self:end;width:min(100%,340px);position:relative;margin:100px 24px 0 0;z-index:1}
.portrait img{width:100%;border-radius:8px 8px 64px 8px;aspect-ratio:1/1.18;object-fit:cover;object-position:50% 40%;box-shadow:var(--shadow-raised)}
.portrait:after{content:'';position:absolute;inset:24px -16px -16px 24px;z-index:-1;border:1px solid color-mix(in srgb,var(--interaction) 45%,transparent);border-radius:0 0 72px 0;border-top:0;border-left:0}
.support{grid-column:2/8;grid-row:2;font-size:21px;line-height:1.5;color:var(--secondary);max-width:46ch;margin-top:8px}
.actions{grid-column:2/9;grid-row:3;display:flex;flex-wrap:wrap;gap:12px}
.hero-axis{position:absolute;inset:20px 0 auto auto;width:78%;height:calc(100% - 64px);z-index:-1;overflow:visible;pointer-events:none;color:var(--interaction)}
.hero-axis path{stroke:currentColor;stroke-width:1;opacity:.28}.hero-axis circle{fill:currentColor;opacity:.65}
@media(min-width:600px) and (max-width:1023px){.hero{padding-block:48px 64px}h1{grid-column:1/7;font-size:clamp(68px,9vw,92px)}.portrait{grid-column:6/-1;width:230px;margin:132px 0 0 0}.support{grid-column:1/6;font-size:20px}.actions{grid-column:1/6}.hero:before{left:36%;inset-block:80px 48px}.hero-axis{width:88%}}
@media(max-width:599px){.hero{padding-block:32px 64px;row-gap:24px}h1{grid-column:1/-1;font-size:clamp(49px,15.3vw,72px);max-width:100%;line-height:.99}.role{max-width:10ch}.focus{font-size:.69em;line-height:1.1;max-width:7.5ch;margin-top:16px}.support-layout{display:contents}.portrait{grid-column:3/-1;grid-row:1;width:132px;margin:132px 0 0;align-self:end;justify-self:end;z-index:0}.portrait img{aspect-ratio:1/1.12;border-radius:8px 8px 40px 8px}.portrait:after{inset:12px -8px -8px 12px;border-radius:0 0 48px 0}.support{grid-column:1/-1;grid-row:2;font-size:18px;line-height:1.55;margin:0;max-width:100%}.actions{grid-column:1/-1;grid-row:3;gap:12px}.button{padding-inline:20px}.hero:before{inset:112px -24px 180px 25%;clip-path:polygon(0 0,100% 0,100% 100%,20% 100%,20% 75%,0 75%)}.hero-axis{inset:48px -8px auto auto;width:100%;height:300px}.hero-axis path{stroke-width:2}}
@media(max-width:359px){.portrait{width:110px;margin-top:140px}h1{font-size:49px}.focus{font-size:.67em}.hero:before{right:-16px}}

</style>
