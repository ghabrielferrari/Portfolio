---
import { Image } from 'astro:assets';
import portrait from '../assets/gabriel-ferrari.png';
import { copy, base, type Locale } from '../i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
---
<section class="hero container grid" id="hero" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="hero-enter">{c.headline}</h1>
  <figure class="portrait hero-enter" style="--delay:70ms">
    <Image src={portrait} widths={[160,240,320,460]} sizes="(max-width:599px) 96px, (max-width:1023px) 180px, 280px" alt="Gabriel Ferrari" loading="eager" fetchpriority="high" format="webp" />
  </figure>
  <p class="support hero-enter" style="--delay:140ms">{c.support}</p>
  <div class="actions hero-enter" style="--delay:210ms">
    <a class="button primary" href="#work">{c.projectsCTA}</a>
    <a class="button" href={locale === 'pt' ? `${base}assets/documents/gabriel-ferrari-cv-pt.pdf` : '#contact'} download={locale === 'pt' ? 'Gabriel-Ferrari-CV-PT.pdf' : undefined}>{c.secondCTA}</a>
  </div>
</section>
<style>

  .hero{position:relative;isolation:isolate;padding-block:80px 112px;row-gap:32px;align-items:start}
  .hero:before{content:'';position:absolute;z-index:-1;inset:24px -32px 48px 56%;border-radius:12px;background:linear-gradient(145deg,var(--wash),transparent 75%);pointer-events:none}
  h1{grid-column:1/9;grid-row:1;font-family:var(--display);font-size:clamp(64px,6.7vw,96px);line-height:1.04;letter-spacing:-.055em;max-width:17ch}
  .portrait{grid-column:10/-1;grid-row:1/4;align-self:center;position:relative;margin-block:24px}
  .portrait:before{content:'';position:absolute;z-index:-1;inset:24px 24px -24px -24px;background:var(--surface);border-radius:12px;box-shadow:var(--shadow-soft)}
  .portrait img{width:100%;border-radius:12px;aspect-ratio:4/5;object-fit:cover;object-position:50% 40%}
  .support{grid-column:1/7;grid-row:2;font-size:22px;line-height:1.5;color:var(--secondary);max-width:48ch}
  .actions{grid-column:1/9;grid-row:3;display:flex;flex-wrap:wrap;gap:12px;margin-top:0}
  @media(min-width:600px) and (max-width:1023px){.hero{padding-block:64px 96px}h1{grid-column:1/7;font-size:clamp(56px,7.3vw,72px)}.portrait{grid-column:7/-1;grid-row:1/3;align-self:center}.support{grid-column:1/6;font-size:20px}.actions{grid-column:1/7}.portrait:before{inset:16px 16px -16px -16px}}
  @media(max-width:599px){.hero{padding-block:48px 64px;row-gap:24px;grid-template-columns:minmax(0,1fr) 88px}.hero:before{inset:16px -8px 40px 48%}h1{grid-column:1/-1;font-size:clamp(42px,11.8vw,64px);line-height:1.08;letter-spacing:-.045em}.support{grid-column:1;grid-row:2;font-size:18px;line-height:1.5}.portrait{grid-column:2;grid-row:2;align-self:start;margin-block:4px 0}.portrait img{aspect-ratio:4/5}.portrait:before{inset:8px 8px -8px -8px}.actions{grid-column:1/-1;grid-row:3;gap:12px;margin-top:8px}.button{padding-inline:20px}}

</style>
