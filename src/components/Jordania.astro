---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n';
import ProjectLinks from './ProjectLinks.astro';
interface Props { project: CollectionEntry<'projects'>; locale: Locale }
const { project, locale } = Astro.props;
const p = project.data[locale];
---
<article class="jordania grid motion-enter" data-motion="content" id="jordania" aria-labelledby="jordania-heading">
  <div class="title"><p class="project-kind">{p.kind}</p><h3 id="jordania-heading">Jordania</h3></div>
  <div class="description">
    <p class="flow">Apple / Google <span aria-hidden="true">→</span> {locale === 'pt' ? 'Autenticação Java/Spring' : 'Java/Spring authentication'} <span aria-hidden="true">→</span> {locale === 'pt' ? 'Sessão iOS' : 'iOS session'}</p>
    <p>{p.contribution}</p>
    <p class="note">{p.note}</p>
    <ProjectLinks project={project} locale={locale}/>
  </div>
</article>
<style>

  .jordania{padding:32px 0;margin-top:64px;border-radius:0;background:none}
  .title{grid-column:1/5}.description{grid-column:5/-1}
  h3{font-family:var(--display);font-size:40px;line-height:1.1;letter-spacing:-.035em}
  .flow{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:18px;margin-bottom:24px;line-height:1.65;color:var(--interaction)}
  .flow span{color:var(--secondary);padding-inline:4px}
  .note{margin-top:16px}
  @media(min-width:600px) and (max-width:1023px){.jordania{padding:24px 0}.title{grid-column:1/4}.description{grid-column:4/-1}}
  @media(max-width:599px){.jordania{padding:24px 0;margin-top:48px}.title,.description{grid-column:1/-1}.flow{margin-top:8px}}

</style>
