---
import { content, links } from '../data/content';
import CaseNotes from './CaseNotes.astro';
import FintechFlow from './FintechFlow.astro';
import { withBase } from '../utils/paths';
import displayFontUrl from '../assets/fonts/bricolage-grotesque-latin-600.woff2?url';
import '../styles/global.css';
interface Props { locale: 'pt' | 'en'; isEntry?: boolean; }
const { locale, isEntry = false } = Astro.props;
const t = content[locale];
const screens = ['carely-search', 'carely-detail', 'carely-confirmation'];
const sections = ['projects', 'profile', 'contact'];
const canonical = new URL(withBase(`${locale}/`), Astro.site);
const cvPath = withBase('documents/gabriel-ferrari-cv-pt.docx');
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-BR' : 'en'} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="theme-color" content="#f4f6fb" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'pt' ? 'pt_BR' : 'en_US'} />
    <title>{t.title}</title>
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(withBase('pt/'), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(withBase('en/'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(withBase(), Astro.site)} />
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      try {
        const stored = localStorage.getItem('gf-theme');
        document.documentElement.dataset.theme = stored === 'dark' || stored === 'light' ? stored : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      } catch { document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    </script>
  </head>
  <body data-language-entry={isEntry ? '' : undefined}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <a class="brand" href={withBase(`${locale}/`)} aria-label="Gabriel Ferrari">
        <svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="M23 10H16a10 10 0 0 0 0 20h8V20H16M31 10v20M31 10h7M31 20h6" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>Gabriel Ferrari</span>
      </a>
      <nav class="main-nav" aria-label={locale === 'pt' ? 'Navegação principal' : 'Main navigation'}>
        {t.nav.map((label, i) => <a href={`#${sections[i]}`} data-nav={sections[i]}>{label}</a>)}
      </nav>
      <div class="header-controls">
        <nav class="languages" aria-label={locale === 'pt' ? 'Idioma' : 'Language'}>
          <a href={withBase('pt/')} lang="pt-BR" hreflang="pt-BR" data-language="pt" aria-current={locale === 'pt' ? 'page' : undefined} aria-label="Português">PT</a>
          <a href={withBase('en/')} lang="en" hreflang="en" data-language="en" aria-current={locale === 'en' ? 'page' : undefined} aria-label="English">EN</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label={t.theme} aria-pressed="false">
          <svg class="sun" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5Z"/></svg>
        </button>
      </div>
    </header>
    <main id="main">
      <section class="hero shell" id="top" aria-labelledby="hero-title">
        <div class="hero-type">
          <h1 id="hero-title"><span>{t.headline[0]}</span><span>{t.headline[1]}</span></h1>
          <div class="hero-support"><p>{t.intro}</p>
            <div class="actions"><a class="button primary" href="#projects">{t.view}<span aria-hidden="true">↘</span></a>
              {locale === 'pt' ? <a class="button secondary" href={cvPath} download>{t.cv}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4"/></svg></a> : <a class="button secondary" href="#contact">{t.contact}<span aria-hidden="true">↗</span></a>}
            </div>
          </div>
        </div>
        <div class="hero-portrait">
          <div class="portrait-orbit" aria-hidden="true"></div>
          <div class="portrait-window"><img src={withBase('media/portrait.webp')} width="1000" height="1000" alt="Gabriel Ferrari" fetchpriority="high" /></div>
          <span class="portrait-caption">Gabriel Ferrari<span>Swift / SwiftUI</span></span>
          <span class="portrait-index" aria-hidden="true">iOS</span>
        </div>
        <div class="hero-foot"><p>{t.heroNote}</p><div class="mini-flow" aria-hidden="true"><span>iOS</span><i></i><span>{locale === 'pt' ? 'Estado' : 'State'}</span><i></i><span>API</span><i></i><span>{locale === 'pt' ? 'Dados' : 'Data'}</span></div><a href="#projects" class="scroll-cue" aria-label={t.jump}>↓</a></div>
      </section>
      <section id="projects" class="work shell" aria-labelledby="work-title">
        <div class="section-opening"><h2 id="work-title">{t.selected}</h2><p>{t.selectedIntro}</p></div>
        <nav class="project-index" aria-label={t.jump}><a href="#carely"><span>Carely</span><small>iOS</small></a><a href="#fintech"><span>Fintech</span><small>iOS + API</small></a><a href="#jordania"><span>Jordania</span><small>{locale === 'pt' ? 'Autenticação' : 'Authentication'}</small></a></nav>
        <article id="carely" class="project carely" aria-labelledby="carely-title">
          <div class="project-title"><div class="project-name"><span class="carely-mark" aria-hidden="true">c</span><div><h3>Carely</h3><p>{t.team} / iOS</p></div></div><h4 id="carely-title">{t.carelyTitle}</h4></div>
          <div class="project-overview"><p class="project-intro">{t.carelyIntro}</p><div class="contribution"><h5>{t.contribution}</h5><p>{t.carelyContribution}</p></div></div>
          <div class="carely-stage" data-reveal="screens">
            <svg class="carely-path" viewBox="0 0 1100 650" preserveAspectRatio="none" fill="none" aria-hidden="true"><path d="M90 460C270 670 315 20 530 160S850 610 1040 330"/></svg>
            {screens.map((src, i) => <figure class={`screen-evidence screen-${i}`}>
              <figcaption><span class="step-number">{i + 1}</span><div><h5>{t.screenTitles[i]}</h5><p>{t.screenCaptions[i]}</p></div></figcaption>
              <button class="screen-button" type="button" data-image={withBase(`media/${src}.webp`)} data-caption={`${t.screenTitles[i]} — ${t.screenCaptions[i]}`} aria-label={`${t.expandImage}: ${t.screenTitles[i]}`}>
                <img src={withBase(`media/${src}.webp`)} width="650" height="1409" alt={t.screenAlts[i]} loading="lazy" /><span class="expand-sign" aria-hidden="true">↗</span>
              </button>
            </figure>)}
          </div>
          <div class="evidence-footer"><p>{t.carelyNote}</p><div class="project-links"><a href={links.appstore} target="_blank" rel="noopener noreferrer">App Store <span aria-hidden="true">↗</span></a><a href={links.carely} target="_blank" rel="noopener noreferrer">{t.repository} <span aria-hidden="true">↗</span></a></div></div>
          <details class="secondary-evidence"><summary>{t.secondary}<span aria-hidden="true">+</span></summary><div class="secondary-content"><p>{t.secondaryText}</p>{['carely-institution', 'carely-institution-info'].map((src, i) => <button type="button" class="screen-button" data-image={withBase(`media/${src}.webp`)} data-caption={t.secondary} aria-label={`${t.expandImage}: ${t.secondary} ${i+1}`}><img src={withBase(`media/${src}.webp`)} width="650" height="1409" loading="lazy" alt={locale === 'pt' ? 'Detalhes de instituição no Carely durante o desenvolvimento.' : 'Carely institution details during development. The app interface is in Portuguese.'}/><span class="expand-sign" aria-hidden="true">↗</span></button>)}</div></details>
          <CaseNotes title={t.decisions} items={t.carelyCase}/>
        </article>
        <article id="fintech" class="project fintech" aria-labelledby="fintech-title">
          <div class="project-title"><div class="project-name"><span class="fintech-mark" aria-hidden="true"><i></i><i></i><i></i></span><div><h3>Fintech</h3><p>{t.personal} / iOS + API</p></div></div><h4 id="fintech-title">{t.fintechTitle}</h4></div>
          <div class="project-overview"><div><span class="status"><i></i>{t.development}</span><p class="project-intro">{t.fintechIntro}</p></div><div class="contribution"><h5>{t.contribution}</h5><p>{t.fintechContribution}</p></div></div>
          <FintechFlow locale={locale}/>
          <div class="project-links fintech-links"><a href={links.fintechIOS} target="_blank" rel="noopener noreferrer">{t.iosRepo} <span aria-hidden="true">↗</span></a><a href={links.fintechAPI} target="_blank" rel="noopener noreferrer">API <span aria-hidden="true">↗</span></a><a href={links.fintechDocs} target="_blank" rel="noopener noreferrer">{t.documentation} <span aria-hidden="true">↗</span></a></div>
          <CaseNotes title={t.decisions} items={t.fintechCase}/>
        </article>
        <article id="jordania" class="project jordania" aria-labelledby="jordania-title">
          <div class="jordania-copy"><div class="project-name"><div><h3>Jordania</h3><p>{t.team} / iOS + Java</p></div></div><h4 id="jordania-title">{t.jordaniaTitle}</h4><p>{t.jordaniaIntro}</p><p class="jordania-note">{t.jordaniaNote}</p><div class="project-links"><a href={links.jordaniaIOS} target="_blank" rel="noopener noreferrer">{t.iosRepo} <span aria-hidden="true">↗</span></a><a href={links.jordaniaAPI} target="_blank" rel="noopener noreferrer">{t.backendRepo} <span aria-hidden="true">↗</span></a></div></div>
          <div class="jordania-graphic" aria-hidden="true"><div class="provider-pair"><span>Apple</span><span>Google</span></div><div class="j-connector"></div><span class="j-session">iOS / {locale === 'pt' ? 'Sessão' : 'Session'}</span><div class="j-connector"></div><span class="j-backend">Java / Spring</span><div class="j-routes"><span>login</span><span>refresh</span><span>logout</span></div></div>
          <div class="jordania-case"><CaseNotes title={t.decisions} items={t.jordaniaCase}/></div>
        </article>
      </section>
      <section id="profile" class="profile-section" aria-labelledby="profile-title"><div class="shell">
        <div class="profile-opening"><h2 id="profile-title">{t.profileTitle.split('\n').map(line => <span>{line}</span>)}</h2><div><p>{t.profileIntro}</p><p>{t.academyIntro}</p></div></div>
        <div class="capabilities">{t.capabilities.map(([title, tech, summary, evidence], i) => <div class={`capability capability-${i}`}><div><h3>{title}</h3><p class="tech-list">{tech}</p></div><p>{summary}</p><a href={i === 0 ? '#carely' : i === 1 ? '#fintech' : '#top'}>{evidence}<span aria-hidden="true">↗</span></a></div>)}</div>
        <div class="education"><h3>{t.education}</h3><div><h4>{t.degree}</h4><p>UNINTER</p><small>{t.expected}</small></div><div><h4>Apple Developer Academy</h4><p>Instituto de Pesquisas Eldorado</p><small>{t.academy}</small></div></div>
      </div></section>
      <section id="contact" class="contact-section shell" aria-labelledby="contact-title"><div class="contact-heading"><h2 id="contact-title">{t.closing.split('\n').map(line => <span>{line}</span>)}</h2><p>{t.closingIntro}</p></div><a class="contact-email" href={`mailto:${links.email}`}><span>{links.email}</span><span class="email-arrow" aria-hidden="true">↗</span><span class="sr-only"> — {t.emailAction}</span></a><div class="contact-bottom"><p>{t.location}</p><div><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></div></div></section>
    </main>
    <footer class="site-footer shell"><span>{t.footer}</span><span>Swift / SwiftUI / iOS</span>{locale === 'en' && <a href={cvPath} download>{t.cv} (Portuguese)</a>}<a href="#top">{t.backTop} <span aria-hidden="true">↑</span></a></footer>
    <dialog class="image-dialog" aria-labelledby="image-caption"><button type="button" class="image-close" aria-label={t.closeImage}>×</button><figure><img alt=""/><figcaption id="image-caption"></figcaption></figure></dialog>
    <script>import '../scripts/site';</script>
  </body>
</html>
