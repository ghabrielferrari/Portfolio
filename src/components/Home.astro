---
import { getCollection } from 'astro:content';
import { copy, type Locale } from '../i18n';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Carely from './Carely.astro';
import Fintech from './Fintech.astro';
import Jordania from './Jordania.astro';
import TechnicalProfile from './TechnicalProfile.astro';
interface Props { locale: Locale }
const { locale } = Astro.props;
const c = copy[locale];
const projects = await getCollection('projects');
const carely = projects.find(p => p.data.id === 'carely');
const fintech = projects.find(p => p.data.id === 'fintech');
const jordania = projects.find(p => p.data.id === 'jordania');
if (!carely || !fintech || !jordania) throw new Error('The three approved projects are required.');
---
<Header locale={locale}/>
<main id="main" tabindex="-1">
  <Hero locale={locale}/>
  <section class="section container" id="work" aria-labelledby="work-heading">
    <div class="section-heading"><h2 id="work-heading">{c.workTitle}</h2><p>{c.workIntro}</p></div>
    <Carely project={carely} locale={locale}/>
    <Fintech project={fintech} locale={locale}/>
    <Jordania project={jordania} locale={locale}/>
  </section>
  <TechnicalProfile locale={locale}/>
  <section class="about section" id="about" aria-labelledby="about-heading">
    <div class="container grid">
      <h2 id="about-heading">{c.about}</h2>
      <div><p class="statement">{c.aboutStatement}</p><p class="context">{c.aboutContext}</p></div>
    </div>
  </section>
  <section class="section container grid education" id="education" aria-labelledby="education-heading">
    <h2 id="education-heading">{c.education}</h2>
    <div class="education-list">
      <article><div><h3>{c.degree}</h3><p>UNINTER</p></div><p class="note">{c.ongoing}</p></article>
      <article><div><h3>Apple Developer Academy</h3><p>Instituto de Pesquisas Eldorado, Campinas</p></div><p class="note">2025–2026</p><p class="education-description">{c.academy}</p></article>
    </div>
  </section>
  <section class="section container contact" id="contact" aria-labelledby="contact-heading">
    <h2 id="contact-heading">{c.contactTitle}</h2>
    <p>{c.contactIntro}</p>
    <a class="email" href="mailto:ghcferrari75@gmail.com">ghcferrari75@gmail.com</a>
    <nav class="project-links" aria-label={c.contact}>
      <a href="https://github.com/ghabrielferrari">GitHub</a>
      <a href="https://www.linkedin.com/in/ghabriel-ferrari/">LinkedIn</a>
    </nav>
  </section>
</main>
<footer class="container"><p>© 2026 Gabriel Ferrari</p><p>{c.location}</p></footer>
<script>
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-entering');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('.evidence-enter').forEach(element => observer.observe(element));
  }
</script>
<style>
  .about{background:var(--surface)}
  .about h2,.education>h2{grid-column:1/5;font-size:28px;line-height:1.25}
  .about .grid>div{grid-column:5/-1}
  .statement{font-size:clamp(28px,3vw,40px);line-height:1.25;letter-spacing:-.025em;max-width:30ch}
  .context{margin-top:32px;color:var(--secondary);max-width:60ch}
  .education-list{grid-column:5/-1}
  .education article{display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px 32px;padding-block:24px;border-top:1px solid var(--divider)}
  .education article:first-child{padding-top:0;border-top:0}
  .education h3{font-size:22px}.education article>div>p{color:var(--secondary);margin-top:8px}.education-description{flex-basis:100%;font-size:16px;color:var(--secondary)}
  .contact{padding-block:96px}
  .contact h2{font-family:var(--display);font-size:clamp(56px,8vw,104px);letter-spacing:-.05em;line-height:1.05}
  .contact>p{margin-top:32px;color:var(--secondary)}
  .email{display:inline-flex;align-items:center;min-height:48px;margin-top:32px;font-size:clamp(22px,3vw,36px);line-height:1.3;max-width:100%;overflow-wrap:anywhere}
  footer{border-top:1px solid var(--divider);display:flex;justify-content:space-between;gap:16px;padding-block:24px;font-size:16px;color:var(--secondary)}
  @media(min-width:600px) and (max-width:1023px){.about h2,.education>h2{grid-column:1/4}.about .grid>div,.education-list{grid-column:4/-1}}
  @media(max-width:599px){.about h2,.education>h2,.about .grid>div,.education-list{grid-column:1/-1}.about h2,.education>h2{font-size:24px;margin-bottom:16px}.contact{padding-block:64px}.contact h2{font-size:clamp(48px,12vw,64px)}.email{font-size:clamp(20px,5.7vw,28px)}footer{flex-direction:column;gap:4px}}
</style>
