---
import type { CollectionEntry } from 'astro:content';
import { type Locale } from '../i18n';
import ProjectLinks from './ProjectLinks.astro';
import FintechFlow from './FintechFlow';
interface Props { project: CollectionEntry<'projects'>; locale: Locale }
const { project, locale } = Astro.props;
const p = project.data[locale];
const pt = locale === 'pt';
const scenarios = pt ? [
  {title:'Requisição autenticada',path:'iOS → Sessão → API → Banco',text:'O cliente obtém a sessão, envia a requisição autenticada e recebe o resultado. A API valida o acesso à conta e à categoria antes da operação no PostgreSQL.',stages:[0,1,2,3],operations:['Requisição autenticada','Obter sessão','Validar acesso','Gravar resultado']},
  {title:'401 + refresh concorrente',path:'iOS → Sessão ↔ API → iOS',text:'Após um 401, AuthenticationSession coordena um único refresh entre requisições concorrentes. O cliente repete a requisição uma vez; quando necessário, invalida a sessão e solicita reautenticação.',stages:[0,1,2],operations:['Resposta 401','Refresh coordenado','Renovar tokens','Fora deste percurso']},
  {title:'Retry com idempotência',path:'iOS → Sessão → API → Banco',text:'O retry preserva o payload e a mesma chave de idempotência da operação. A API valida ownership; o PostgreSQL mantém a gravação e o resultado de idempotência na mesma transação.',stages:[0,1,2,3],operations:['Repetir a operação','Autenticar o retry','Validar ownership','Mesma chave, uma transação']},
] : [
  {title:'Authenticated request',path:'iOS → Session → API → Database',text:'The client obtains its session, sends an authenticated request, and receives the result. The API validates access to the account and category before the PostgreSQL operation.',stages:[0,1,2,3],operations:['Authenticated request','Obtain session','Validate access','Write result']},
  {title:'401 + concurrent refresh',path:'iOS → Session ↔ API → iOS',text:'After a 401, AuthenticationSession coordinates one refresh across concurrent requests. The client retries the request once; when needed, it invalidates the session and requests reauthentication.',stages:[0,1,2],operations:['401 response','Coordinated refresh','Rotate tokens','Outside this path']},
  {title:'Retry with idempotency',path:'iOS → Session → API → Database',text:'A retry preserves the payload and the same operation’s idempotency key. The API validates ownership; PostgreSQL keeps the write and idempotency result within the same transaction.',stages:[0,1,2,3],operations:['Retry the operation','Authenticate the retry','Validate ownership','Same key, one transaction']},
];
const units: [string,string,string][] = [
  [pt ? 'Cliente iOS' : 'iOS client','SwiftUI',pt ? 'Interface e estados da operação' : 'Interface and operation states'],
  ['AuthenticationSession','Networking / Keychain',pt ? 'Sessão, credenciais e refresh' : 'Session, credentials, and refresh'],
  ['API NestJS',pt ? 'Autenticação / validação' : 'Authentication / validation',pt ? 'Ownership de conta e categoria' : 'Account and category ownership'],
  ['PostgreSQL',pt ? 'Consistência / idempotência' : 'Consistency / idempotency',pt ? 'Gravação e resultado atômicos' : 'Atomic write and result'],
];
---
<article class="fintech" id="fintech" aria-labelledby="fintech-heading">
  <div class="intro grid">
    <div class="title motion-enter" data-motion="title"><p class="project-kind">{p.kind}</p><h3 class="project-title" id="fintech-heading">Fintech</h3><p class="project-summary">{p.summary}</p></div>
    <div class="description"><p>{p.contribution}</p><ProjectLinks project={project} locale={locale}/></div>
  </div>
  <FintechFlow scenarios={scenarios} units={units} note={p.note} locale={locale} client:visible={{rootMargin:'250px'}} />
</article>

<style>

.fintech{margin-top:80px;position:relative;isolation:isolate}
.title{grid-column:1/6}.description{grid-column:7/-1;padding-top:8px}.project-title{font-size:clamp(56px,6vw,88px)}
@media(min-width:768px) and (max-width:1023px){.title{grid-column:1/5}.description{grid-column:5/-1}}
@media(max-width:767px){.fintech{margin-top:64px}.title,.description{grid-column:1/-1}.description{margin-top:8px}.project-title{font-size:64px}}

</style>
