---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { copy, type Locale } from '../i18n';
interface Props { image: CollectionEntry<'projects'>['data']['images'][number]; locale: Locale; index: number }
const { image, locale, index } = Astro.props;
const caption = image[locale];
---
<figure class:list={['screen', `screen-${index}`, 'evidence-enter']} style={`--delay:${index * 70}ms`}>
  <a href={image.src.src} data-enlarge data-title={caption.title} aria-label={`${copy[locale].enlarge}: ${caption.title}`}>
    <Image src={image.src} widths={[240,300,360,540,738]} sizes={index === 1 ? '(max-width:599px) 258px, (max-width:1023px) 26vw, 290px' : index === 2 ? '(max-width:599px) 276px, (max-width:1023px) 28vw, 310px' : '(max-width:599px) 300px, (max-width:1023px) 30vw, 335px'} alt={caption.alt} loading="lazy" decoding="async" format="webp" quality={85} />
    <span class="zoom" aria-hidden="true">+ {copy[locale].enlarge}</span>
  </a>
  <figcaption class="caption"><strong>{index < 3 && <span class="step" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>}{caption.title}</strong><span>{caption.implementation}</span></figcaption>
</figure>
<style>

  .screen{min-width:0;position:relative}
  a{display:block;border-radius:12px;cursor:zoom-in;text-decoration:none}
  img{width:100%;border-radius:12px;box-shadow:var(--shadow);transition:transform 320ms var(--ease),box-shadow 320ms var(--ease)}
  a:focus-visible img{transform:translateY(-4px)}
  .zoom{display:flex;align-items:center;min-height:44px;font-size:16px;line-height:1.3;margin-top:8px;gap:8px}
  .caption{padding-top:8px}.caption strong{display:flex;align-items:baseline;gap:12px}.caption .step{display:inline;color:var(--interaction);font-size:14px;font-weight:600;flex-shrink:0;margin:0}.caption:before{display:none}
  @media(hover:hover){a:hover img{transform:translateY(-6px);box-shadow:var(--shadow-raised)}}
  @media(min-width:600px){.screen-1{padding-top:96px}.screen-2{padding-top:176px}}
  @media(max-width:599px){.screen{width:min(100%,300px);align-self:start}.screen-1{width:min(86%,258px);align-self:end}.screen-2{width:min(92%,276px)}.screen-3,.screen-4{width:min(100%,276px)}.screen-4{align-self:end}}

</style>
