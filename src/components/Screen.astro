---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { copy, type Locale } from '../i18n';
interface Props { image: CollectionEntry<'projects'>['data']['images'][number]; locale: Locale; index: number }
const { image, locale, index } = Astro.props;
const caption = image[locale];
---
<figure class:list={['screen', `screen-${index}`, 'motion-enter']} data-motion="screen" style={`--delay:${index * 70}ms;--entry-angle:${index === 1 ? 1.5 : -1.5}deg`}>
  <figcaption class="caption"><strong>{index < 3 && <span class="step" aria-hidden="true">{String(index+1).padStart(2,'0')}</span>}{caption.title}</strong><span>{caption.implementation}</span></figcaption>
  <a href={image.src.src} data-enlarge data-title={caption.title} aria-label={`${copy[locale].enlarge}: ${caption.title}`}>
    <Image src={image.src} widths={[240,300,360,540,738]} sizes={index === 1 ? '(max-width:599px) 258px, (max-width:1023px) 25vw, 340px' : index === 2 ? '(max-width:599px) 276px, (max-width:1023px) 29vw, 380px' : '(max-width:599px) 300px, (max-width:1023px) 34vw, 460px'} alt={caption.alt} loading="lazy" decoding="async" format="webp" quality={85} />
    <span class="zoom" aria-hidden="true">+ {copy[locale].enlarge}</span>
  </a>

</figure>
<style>

.screen{min-width:0;position:relative}
a{display:block;border-radius:12px;cursor:zoom-in;text-decoration:none;position:relative}
img{width:100%;border-radius:12px;box-shadow:var(--shadow);transition:transform 380ms var(--ease),box-shadow 380ms var(--ease)}
a:focus-visible img{transform:translateY(-4px)}
.zoom{display:flex;align-items:center;min-height:44px;font-size:16px;line-height:1.3;margin-top:8px;gap:8px}
.caption{padding:0 0 20px;max-width:32ch;min-height:100px;position:relative}.caption strong{font-size:20px;display:flex;align-items:baseline;gap:12px}.caption .step{display:inline;color:var(--interaction);font-size:14px;font-weight:600;flex-shrink:0;margin:0}.caption:before{content:'';display:block;width:24px;height:20px;border-left:1px solid var(--interaction);border-top:1px solid var(--interaction);background:none;position:absolute;left:-16px;top:4px;transform:translateX(-100%);opacity:.6}
@media(hover:hover){a:hover img{transform:translateY(-4px) scale(1.008);box-shadow:var(--shadow-raised)}}
a:active img{transform:scale(.995)}
@media(max-width:599px){.caption{min-height:0;padding-bottom:20px}.caption:before{left:-8px;width:12px}.screen{width:min(100%,300px);justify-self:start}.screen-1{width:min(86%,258px);justify-self:end}.screen-2{width:min(92%,276px)}.screen-3,.screen-4{width:min(100%,276px)}.screen-4{justify-self:end}}

</style>
