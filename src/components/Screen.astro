---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { copy, type Locale } from '../i18n';
interface Props { image: CollectionEntry<'projects'>['data']['images'][number]; locale: Locale; index: number }
const { image, locale, index } = Astro.props;
const caption = image[locale];
---
<figure class:list={['screen', `screen-${index}`, 'evidence-enter']} style={`--delay:${index * 70}ms`}>
  <a href={image.src.src} data-enlarge data-title={caption.title} aria-label={`${copy[locale].enlarge}: ${caption.title}`}>
    <Image src={image.src} widths={[240,300,360,540,738]} sizes={index === 1 ? '(max-width:599px) 258px, (max-width:1023px) 30vw, 258px' : index === 2 ? '(max-width:599px) 276px, (max-width:1023px) 28vw, 240px' : '(max-width:599px) 300px, (max-width:1023px) 35vw, 300px'} alt={caption.alt} loading="lazy" decoding="async" format="webp" quality={85} />
    <span class="zoom" aria-hidden="true">+ {copy[locale].enlarge}</span>
  </a>
  <figcaption class="caption"><strong>{caption.title}</strong><span>{caption.implementation}</span></figcaption>
</figure>
<style>
  .screen{min-width:0}
  a{display:block;border-radius:12px;cursor:zoom-in;text-decoration:none}
  img{width:100%;border-radius:12px;box-shadow:0 8px 24px #00000010}
  .zoom{display:flex;align-items:center;min-height:44px;font-size:16px;line-height:1.3;margin-top:4px}
  @media(min-width:600px){.screen-1{padding-top:96px}.screen-2{padding-top:192px}}
  @media(max-width:599px){.screen{width:min(100%,300px);align-self:start}.screen-1{width:min(86%,258px);align-self:end}.screen-2{width:min(92%,276px)}.screen-3,.screen-4{width:min(100%,276px)}.screen-4{align-self:end}}
</style>
